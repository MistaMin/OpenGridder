@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://opengrid.studio/plugins/opengridder>
    a lv2:Plugin ;
    doap:name "OpenGridder" ;
    doap:maintainer [
        foaf:name "OpenGrid Studio" ;
        foaf:homepage <https://github.com/MistaMin/OpenGridder> ;
    ] ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "Audio In L" ;
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "Audio In R" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "bypass" ;
        lv2:name "Master Bypass" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "remote_plugin" ;
        lv2:name "Remote Plugin" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 128.0 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "latency_profile" ;
        lv2:name "Latency Profile" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 3.0 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "input_gain" ;
        lv2:name "Input Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 24.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "wet_dry_mix" ;
        lv2:name "Wet/Dry Mix" ;
        lv2:default 100.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "drive" ;
        lv2:name "Drive / Sat" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "output_gain" ;
        lv2:name "Output Trim" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 24.0 ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 11 ;
        lv2:symbol "latency" ;
        lv2:name "latency" ;
        lv2:portProperty lv2:reportsLatency ;
    ] .
